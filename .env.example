# Paper mode only. No Binance API credentials are used.
# Exclude the 50 highest-volume USDT perpetuals, then monitor up to 200 more.
EXCLUDE_TOP_VOLUME=50
MAX_UNIVERSE_SYMBOLS=200

DB_PATH=data/paper_engine.sqlite3
STRATEGY_INTERVAL=15m
SEED_CANDLES=120
MARK_POLL_SECONDS=3
STARTING_BALANCE_USDT=1000
MAX_POSITIONS=5
LEVERAGE=10
TAKER_FEE_RATE=0.0005
TAKE_PROFIT_USDT=10
STOP_LOSS_USDT=5
DAILY_LOSS_LIMIT_USDT=50
