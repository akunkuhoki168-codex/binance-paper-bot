# Paper mode only. No Binance API credentials are used.
DB_PATH=data/paper_engine.sqlite3
FUTURES_SYMBOLS=BTCUSDT,ETHUSDT,BNBUSDT,SOLUSDT,XRPUSDT
STRATEGY_INTERVAL=15m
SEED_CANDLES=120
MARK_POLL_SECONDS=3
STARTING_BALANCE_USDT=1000
MAX_POSITIONS=5
LEVERAGE=10
# Allocation: fixed or compounding.
ALLOCATION_MODE=fixed
TAKER_FEE_RATE=0.0005
TAKE_PROFIT_USDT=10
STOP_LOSS_USDT=5
# Retained for backward-compatible configuration; daily auto-pause is disabled.
DAILY_LOSS_LIMIT_USDT=50
