# Paper mode only. No Binance API credentials are used.
# CoinMarketCap API key is used only to read market-cap rankings.
CMC_API_KEY=
CMC_RANK_START=51
CMC_RANK_LIMIT=5000
# Maximum number of matching Binance USDT perpetuals monitored at once.
MAX_UNIVERSE_SYMBOLS=200

DB_PATH=data/paper_engine.sqlite3
STRATEGY_INTERVAL=15m
SEED_CANDLES=120
MARK_POLL_SECONDS=3
STARTING_BALANCE_USDT=1000
MAX_POSITIONS=5
LEVERAGE=10
TAKER_FEE_RATE=0.0005
TAKE_PROFIT_USDT=10
STOP_LOSS_USDT=5
# Pause new entries after this much net realized loss in one UTC day. Set 0 to disable.
DAILY_LOSS_LIMIT_USDT=50
